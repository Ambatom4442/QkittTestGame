# .github/workflows/harness-check.yml — generated by Q-HEAT {{KIT_VERSION}}.
# Make "harness-check" a required status check in branch protection (a human does this).
# For Azure Pipelines / GitLab / Jenkins, keep the same steps.
name: harness-check

on:
  pull_request:
  push:
    branches: [{{DEFAULT_BRANCH}}]

permissions:
  contents: read

concurrency:
  group: harness-check-${{ github.ref }}
  cancel-in-progress: true

jobs:
  harness-check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # policy_check needs history to diff against the base

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # {{Add language setup here, e.g. actions/setup-node@v4 with node-version-file: .nvmrc}}

      - name: Setup (same path agents use)
        run: ./init.sh

      - name: Kit / harness integrity
        run: python q_heat_kit/scripts/qhc_check.py --harness .

      - name: Policy
        env:
          BRANCH_NAME: ${{ github.head_ref || github.ref_name }}
        run: python harness/checks/policy_check.py --base origin/${{ github.base_ref || '{{DEFAULT_BRANCH}}' }}

      - name: Full check (all blocking sensors)
        run: make check

      - name: Upload evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: harness-evidence
          path: |
            {{test-results/}}
            {{playwright-report/}}
          if-no-files-found: ignore
