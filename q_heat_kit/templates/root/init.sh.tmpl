#!/usr/bin/env bash
# init.sh — standard setup + smoke check for {{PROJECT_NAME}}.
# Generated by Q-HEAT {{KIT_VERSION}}. Safe to run more than once (idempotent).
# On Windows without bash, provide init.ps1 with the same steps.
set -euo pipefail

say()  { printf '\n==> %s\n' "$*"; }
fail() { printf '\nWHAT: %s\nWHY:  %s\nFIX:  %s\n' "$1" "$2" "$3" >&2; exit 1; }

# 1. Confirm repository root
[ -f AGENTS.md ] || fail "init.sh was not run from the repository root." \
  "All paths in the harness are relative to the root." "cd to the folder that contains AGENTS.md and re-run."

# 2. Check tool versions (pinned in version files)
say "Checking tools"
{{e.g. command -v node >/dev/null || fail "node not found" "The app runs on Node $(cat .nvmrc)" "Install Node $(cat .nvmrc) (nvm use)"}}
{{e.g. command -v docker >/dev/null || fail "docker not found" "Local services run in containers" "Install Docker Desktop and start it"}}

# 3. Install dependencies from lock files
say "Installing dependencies"
{{e.g. npm ci  |  uv sync --frozen  |  dotnet restore --locked-mode}}

# 4. Environment file
if [ ! -f .env ] && [ -f .env.example ]; then
  say "Creating .env from .env.example (local placeholder values only)"
  cp .env.example .env
fi

# 5. Local services and seed data
say "Starting local services"
{{e.g. docker compose up -d db}}
{{e.g. ./scripts/wait-for-db.sh && ./scripts/seed-local.sh}}

# 6. Smoke check
say "Running smoke check"
{{CHECK_FAST_COMMAND}}

say "Ready. Next: {{START_COMMAND}}  (fast check: {{CHECK_FAST_COMMAND}})"
