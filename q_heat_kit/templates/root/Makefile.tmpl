# Harness targets for {{PROJECT_NAME}} — generated by Q-HEAT {{KIT_VERSION}}.
# Commands come from harness/sensors.json tiers. Recipes must be indented with a TAB.
.PHONY: setup start check-fast check-changed check

setup:
	./init.sh

start:
	{{START_COMMAND}}

check-fast:   ## format, lint, types, unit tests, cheap architecture rules (~1 min)
	{{LINT_COMMAND}}
	{{TYPECHECK_COMMAND}}
	{{UNIT_TEST_COMMAND}}
	python harness/checks/policy_check.py --base origin/{{DEFAULT_BRANCH}}

check-changed: check-fast  ## + tests for changed paths
	{{CHANGED_TESTS_COMMAND}}

check: check-fast  ## everything CI runs
	{{INTEGRATION_TEST_COMMAND}}
	{{E2E_COMMAND}}
	{{BUILD_COMMAND}}
