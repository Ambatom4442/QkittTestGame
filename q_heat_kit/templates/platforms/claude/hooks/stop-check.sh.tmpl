#!/usr/bin/env bash
# stop-check.sh — Claude Code Stop hook (target path: harness/hooks/stop-check.sh).
# Blocks the agent from finishing while the fast check fails or progress is not updated.
# Exit 0 = allow stop. Exit 2 = keep working (stderr is shown to Claude).
# Generated by Q-HEAT. Hooks can fail open — CI remains the real gate.
set -uo pipefail
cd "${CLAUDE_PROJECT_DIR:-.}" || exit 0

input="$(cat)"
# Avoid an endless loop: if this stop was already blocked once, allow it.
if printf '%s' "$input" | grep -q '"stop_hook_active"[[:space:]]*:[[:space:]]*true'; then
  exit 0
fi

# Nothing changed in this session? Allow stop.
if [ -z "$(git status --porcelain)" ] && git diff --quiet "@{upstream}" 2>/dev/null; then
  exit 0
fi

if ! out="$(make check-fast 2>&1)"; then
  {
    echo "WHAT: make check-fast fails, so the session cannot end yet."
    echo "WHY:  Every session must leave a clean, restartable state (AGENTS.md, clean state)."
    echo "FIX:  Read the failures below, fix the cause (not the test), re-run make check-fast."
    printf '%s\n' "$out" | tail -n 30
  } >&2
  exit 2
fi

changed_code="$(git status --porcelain | grep -v 'harness/progress.md' | grep -v 'harness/sessions/' || true)"
progress_touched="$(git status --porcelain -- harness/progress.md harness/sessions/ || true)"
if [ -n "$changed_code" ] && [ -z "$progress_touched" ] && ! git diff --name-only "@{upstream}" 2>/dev/null | grep -qE 'harness/(progress.md|sessions/)'; then
  {
    echo "WHAT: Code changed but harness/progress.md was not updated."
    echo "WHY:  The next session depends on the progress log to continue without guessing."
    echo "FIX:  Update the current-state block and add a session-log entry, then commit."
  } >&2
  exit 2
fi

exit 0
