{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "shared/src/**/*.ts",
    "shared/test/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.mjs",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
